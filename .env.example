# ---- Legal gate (spec §3 rule 4) ----
# Keep false until MOE gives written permission to reuse SchoolFinder COPs.
COP_SOURCE_PERMITTED=false
# COP reference year if not set in admin (PSLE 2026 parents use 2025 COPs).
COP_YEAR=2025

# ---- Banding thresholds ----
BAND_SAFE_MARGIN=3
BAND_BORDERLINE_MARGIN=2

# ---- Database ----
# Production: Postgres (e.g. Supabase). Leave empty to use embedded PGlite in ./.data/pglite (local dev only).
DATABASE_URL=
PGLITE_DIR=./.data/pglite

# ---- AI provider: anthropic | bedrock | groq | mock ----
# Blank = auto: anthropic if ANTHROPIC_API_KEY is set, else groq if GROQ_API_KEY is set, else mock.
LLM_PROVIDER=
# Blank = provider default: claude-opus-5-5 (anthropic/bedrock), openai/gpt-oss-120b (groq).
LLM_MODEL=
LLM_EFFORT=medium
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# For bedrock: standard AWS credentials + region
AWS_REGION=ap-southeast-1

# ---- Payments (Stripe). Without STRIPE_SECRET_KEY in dev, "unlock" issues a free test pass. ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PAYMENT_METHOD_CONFIG=
APP_URL=http://localhost:3000

# ---- Pricing (SGD cents) ----
PRICE_SEASON_CENTS=2400
PRICE_SEASON_EARLYBIRD_CENTS=1800
PRICE_FAMILY_CENTS=4000
PRICE_FAMILY_EARLYBIRD_CENTS=3200
EARLYBIRD_START=2026-09-01
EARLYBIRD_END=2026-11-30
FAMILY_PASS_ENABLED=true

# ---- Free tier ----
FREE_CHAT_MESSAGES=5
FREE_MATCH_PREVIEW=3

# ---- Security ----
# Long random string; signs pass and usage cookies.
COOKIE_SECRET=
# Enables /admin (HTTP Basic auth, any username). Admin is disabled when empty.
ADMIN_PASSWORD=

# ---- Public-transport commute times (optional) ----
# Free OneMap account (register at onemap.gov.sg). Enables real MRT/bus travel times for ranking,
# the "max travel time" filter and route details on school pages. Without it, straight-line distance is used.
ONEMAP_EMAIL=
ONEMAP_PASSWORD=
COMMUTE_DEPART_TIME=06:45:00

# ---- Google Maps route on school pages (optional) ----
# Maps Embed API key. Without it, school pages still show an "Open in Google Maps" directions link.
# In Google Cloud, restrict the key to your site's domain (HTTP referrers) and to the Maps Embed API only.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# ---- data.gov.sg (optional API key for higher rate limits) ----
DATA_GOV_SG_API_KEY=
